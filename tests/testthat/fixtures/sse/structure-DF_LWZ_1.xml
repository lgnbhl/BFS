        <common:Name xml:lang="de">Leer stehende Wohnungen nach Grossregion, Kanton, Bezirk, Gemeinde, Anzahl Wohnräumen und Typ der Leerwohnung</common:Name>
        <common:Name xml:lang="fr">Logements vacants selon la grande région, le canton, le district, la commune, le nombre de pièces d'habitation et le type de logement vacant</common:Name>
